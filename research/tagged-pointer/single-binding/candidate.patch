+// RHS-only lookup: the One form never escapes synchronous substitution.
+#[derive(Clone, Copy)]
+pub(in crate::runtime) enum RuleBindingView<'a> {
+    Map(&'a SymbolExprMap),
+    One { name: Symbol, value: &'a Expr },
+}
+
+impl<'a> RuleBindingView<'a> {
+    fn get(self, symbol: &Symbol) -> Option<&'a Expr> {
+        match self {
+            Self::Map(bindings) => bindings.get(symbol),
+            Self::One { name, value } => (name == *symbol).then_some(value),
+        }
+    }
+
+    fn contains_key(self, symbol: &Symbol) -> bool {
+        self.get(symbol).is_some()
+    }
+
+    fn is_empty(self) -> bool {
+        match self {
+            Self::Map(bindings) => bindings.is_empty(),
+            Self::One { .. } => false,
+        }
+    }
+}
+
 pub(in crate::runtime) fn substitute_rule_bindings(expr: &Expr, bindings: &SymbolExprMap) -> Expr {
+    substitute_rule_bindings_view(expr, RuleBindingView::Map(bindings))
+}
