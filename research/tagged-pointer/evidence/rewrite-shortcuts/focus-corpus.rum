SetAttributes[flatMeasure, HoldAll];
flatMeasure[label_String, expression_, expected_] := Module[{i, result, resultAlias, seconds},
  result = expression;
  If[SameQ[result, expected], Null, Exit[2]];
  Do[
    seconds = First[AbsoluteTiming[result = expression]];
    Print[StringJoin["ISO_TIME\t", label, "\t", ToString[i], "\t", ToString[seconds]]];
    If[SameQ[result, expected], Null, Exit[2]],
    {i, 1, 11}
  ];
  resultAlias = result;
  result[[1]] = flatResultMutation;
  If[SameQ[resultAlias, expected], Null, Exit[2]];
];
SetAttributes[focusHead, Flat];
focusInput = Range[1024]; focusAlias = focusInput;
focusExpected = Range[2,1025];
flatMeasure["focus-increment-1024", Replace[focusInput, focusX_Integer :> focusX + 1, {1}], focusExpected];
If[SameQ[focusInput, Range[1024]] && SameQ[focusAlias, Range[1024]], Null, Exit[2]];
focusInput = Range[16000]; focusAlias = focusInput;
focusExpected = Range[2,16001];
flatMeasure["focus-increment-16000", Replace[focusInput, focusX_Integer :> focusX + 1, {1}], focusExpected];
If[SameQ[focusInput, Range[16000]] && SameQ[focusAlias, Range[16000]], Null, Exit[2]];
focusInput = Range[1024]; focusAlias = focusInput;
focusExpected = Range[2,1025];
flatMeasure["focus-increment-reversed-1024", Replace[focusInput, focusX_Integer :> 1 + focusX, {1}], focusExpected];
If[SameQ[focusInput, Range[1024]] && SameQ[focusAlias, Range[1024]], Null, Exit[2]];
focusInput = Range[16000]; focusAlias = focusInput;
focusExpected = Range[2,16001];
flatMeasure["focus-increment-reversed-16000", Replace[focusInput, focusX_Integer :> 1 + focusX, {1}], focusExpected];
If[SameQ[focusInput, Range[16000]] && SameQ[focusAlias, Range[16000]], Null, Exit[2]];
focusInput = Range[1024]; focusAlias = focusInput;
focusExpected = Range[1024];
flatMeasure["focus-identity-1024", Replace[focusInput, focusX_Integer :> focusX, {1}], focusExpected];
If[SameQ[focusInput, Range[1024]] && SameQ[focusAlias, Range[1024]], Null, Exit[2]];
focusInput = Range[16000]; focusAlias = focusInput;
focusExpected = Range[16000];
flatMeasure["focus-identity-16000", Replace[focusInput, focusX_Integer :> focusX, {1}], focusExpected];
If[SameQ[focusInput, Range[16000]] && SameQ[focusAlias, Range[16000]], Null, Exit[2]];
focusInput = Range[1024]; focusAlias = focusInput;
focusExpected = Range[1024];
flatMeasure["focus-miss-1024", Replace[focusInput, focusMissing -> 0, {1}], focusExpected];
If[SameQ[focusInput, Range[1024]] && SameQ[focusAlias, Range[1024]], Null, Exit[2]];
focusInput = Range[16000]; focusAlias = focusInput;
focusExpected = Range[16000];
flatMeasure["focus-miss-16000", Replace[focusInput, focusMissing -> 0, {1}], focusExpected];
If[SameQ[focusInput, Range[16000]] && SameQ[focusAlias, Range[16000]], Null, Exit[2]];
focusInput = Range[1024]; focusAlias = focusInput;
focusExpected = Table[focusOpaque[i],{i,1,1024}];
flatMeasure["focus-opaque-body-1024", Replace[focusInput, focusX_Integer :> focusOpaque[focusX], {1}], focusExpected];
If[SameQ[focusInput, Range[1024]] && SameQ[focusAlias, Range[1024]], Null, Exit[2]];
focusInput = Range[16000]; focusAlias = focusInput;
focusExpected = Table[focusOpaque[i],{i,1,16000}];
flatMeasure["focus-opaque-body-16000", Replace[focusInput, focusX_Integer :> focusOpaque[focusX], {1}], focusExpected];
If[SameQ[focusInput, Range[16000]] && SameQ[focusAlias, Range[16000]], Null, Exit[2]];
focusInput = Range[1024]; focusAlias = focusInput;
focusExpected = Table[focusHead[i,1],{i,1,1024}];
flatMeasure["focus-flat-nested-1024", Replace[focusInput, focusX_Integer :> focusHead[focusHead[focusX],1], {1}], focusExpected];
If[SameQ[focusInput, Range[1024]] && SameQ[focusAlias, Range[1024]], Null, Exit[2]];
focusInput = Range[16000]; focusAlias = focusInput;
focusExpected = Table[focusHead[i,1],{i,1,16000}];
flatMeasure["focus-flat-nested-16000", Replace[focusInput, focusX_Integer :> focusHead[focusHead[focusX],1], {1}], focusExpected];
If[SameQ[focusInput, Range[16000]] && SameQ[focusAlias, Range[16000]], Null, Exit[2]];
Print["ISO_FOCUS_PASS"];
