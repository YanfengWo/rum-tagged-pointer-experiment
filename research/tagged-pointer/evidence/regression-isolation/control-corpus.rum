SetAttributes[isoMeasure, HoldAll];
isoMeasure[label_String, expression_, expected_] := Module[{i, result, seconds},
  result = expression;
  If[SameQ[result, expected], Null, Exit[2]];
  Do[
    seconds = First[AbsoluteTiming[result = expression]];
    Print[StringJoin["ISO_TIME\t", label, "\t", ToString[i], "\t", ToString[seconds]]],
    {i, 1, 11}
  ];
  If[SameQ[result, expected], Null, Exit[2]];
];
isoPart = Table[0, {400}];
isoMeasure["control-set-part-400",
  (Do[isoPart[[i]] = i, {i, 1, 400}]; isoPart), Range[400]];
isoPart = Table[0, {1600}];
isoMeasure["control-set-part-1600",
  (Do[isoPart[[i]] = i, {i, 1, 1600}]; isoPart), Range[1600]];
isoInput = Reverse[Range[8000]]; isoAlias = isoInput;
isoMeasure["control-sort-8000", Sort[isoInput], Range[8000]];
If[SameQ[isoInput, Reverse[Range[8000]]] && SameQ[isoInput, isoAlias], Null, Exit[2]];
isoInput = Reverse[Range[16000]]; isoAlias = isoInput;
isoMeasure["control-sort-16000", Sort[isoInput], Range[16000]];
If[SameQ[isoInput, Reverse[Range[16000]]] && SameQ[isoInput, isoAlias], Null, Exit[2]];
isoInput = Range[16000]; isoAlias = isoInput;
isoMeasure["control-rewrite-miss-16000", Replace[isoInput, isoMissing -> 0, {1}], Range[16000]];
isoMeasure["control-rewrite-hit-16000", Replace[isoInput, isoX_Integer :> isoX + 1, {1}], Range[2, 16001]];
If[SameQ[isoInput, Range[16000]] && SameQ[isoInput, isoAlias], Null, Exit[2]];
Print["ISO_CONTROL_PASS"];
