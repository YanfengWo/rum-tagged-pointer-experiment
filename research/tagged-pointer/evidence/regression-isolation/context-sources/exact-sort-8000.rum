ctxInput = Reverse[Range[8000]]; ctxAlias = ctxInput;
ctxResult = Sort[ctxInput];
If[SameQ[ctxResult, Range[8000]] && (SameQ[ctxInput, Reverse[Range[8000]]] && SameQ[ctxInput, ctxAlias]), Null, Exit[2]];
Do[
  ctxSeconds = First[AbsoluteTiming[ctxResult = Sort[ctxInput]]];
  Print[StringJoin["ISO_TIME\t", "exact-sort-8000", "\t", ToString[ctxI], "\t", ToString[ctxSeconds]]];
  If[SameQ[ctxResult, Range[8000]] && (SameQ[ctxInput, Reverse[Range[8000]]] && SameQ[ctxInput, ctxAlias]), Null, Exit[2]],
  {ctxI, 1, 11}
];
Print["ISO_CONTEXT_PASS"];
