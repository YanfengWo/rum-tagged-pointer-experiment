+//! Isolated same-binary diagnostic. Not a production configuration API.
+use std::sync::OnceLock;
+
+static MODE: OnceLock<u8> = OnceLock::new();
+const ENV: &str = "RUM_REWRITE_SHORTCUTS_MODE";
+
+pub(super) fn initialize() {
+    MODE.get_or_init(read_mode);
+}
+
+#[inline]
+fn mode() -> u8 {
+    *MODE.get().expect("rewrite shortcut mode initialized by Session::empty")
+}
+
+#[inline]
+pub(super) fn matcher_enabled() -> bool {
+    mode() & 1 != 0
+}
+
+#[inline]
+pub(super) fn depth_enabled() -> bool {
+    mode() & 2 != 0
+}
+
+#[cold]
+fn read_mode() -> u8 {
+    let value = match std::env::var(ENV) {
+        Ok(value) => value,
+        Err(std::env::VarError::NotPresent) => return 0,
+        Err(std::env::VarError::NotUnicode(_)) => {
+            panic!("{ENV} must contain a Unicode mode name")
+        }
+    };
+    parse_mode(&value).unwrap_or_else(|| {
+        panic!("{ENV} must be base, matcher, depth or combined")
+    })
+}
+
+fn parse_mode(value: &str) -> Option<u8> {
+    match value {
+        "base" => Some(0),
+        "matcher" => Some(1),
+        "depth" => Some(2),
+        "combined" => Some(3),
+        _ => None,
+    }
+}
