(* Diagnostic input, not an uninstrumented performance benchmark. *)
gHotInput = Range[8]; gHotResult = Null;
RumProfileSnapshot["before"];
RumProfileReset[];
gHotResult = Replace[gHotInput, x_Integer :> x + 1, {1}];
RumProfileSnapshot["after"];
If[SameQ[gHotInput, Range[8]] && SameQ[gHotResult, Range[2, 9]], Null, Exit[2]];
Print["RUM_HOTSPOT_PASS\trewrite-wide\t8\tactive"];
