(* Focused monotonic timings; individual repetitions are retained. *)
SetAttributes[copyMeasure, HoldAll];
copyMeasure[label_String, expression_, expected_] := Module[{i, result, seconds},
  result = expression;
  If[SameQ[result, expected], Null, Exit[2]];
  Do[
    seconds = First[AbsoluteTiming[result = expression]];
    Print[StringJoin["COPY_TIME\t", label, "\t", ToString[i], "\t", ToString[seconds]]],
    {i, 1, 11}
  ];
  If[SameQ[result, expected], Null, Exit[2]];
];
copyInput = Range[4000]; copyAlias = copyInput;
copyMeasure["rewrite-hit-4000", Replace[copyInput, copyX_Integer :> copyX + 1, {1}], Range[2, 4001]];
If[SameQ[copyInput, Range[4000]] && SameQ[copyAlias, copyInput], Null, Exit[2]];
copyMeasure["rewrite-identity-4000", Replace[copyInput, copyX_Integer :> copyX, {1}], Range[4000]];
If[SameQ[copyInput, Range[4000]] && SameQ[copyAlias, copyInput], Null, Exit[2]];
copyMeasure["rewrite-miss-4000", Replace[copyInput, copyMissing -> 0, {1}], Range[4000]];
If[SameQ[copyInput, Range[4000]] && SameQ[copyAlias, copyInput], Null, Exit[2]];
copyCompound = Table[copyF[i, i + 1], {i, 1, 4000}]; copyCompoundAlias = copyCompound;
copyMeasure["rewrite-compound-miss-4000", Replace[copyCompound, copyMissing -> 0, {1}], copyCompound];
If[SameQ[copyCompoundAlias, copyCompound], Null, Exit[2]];
copyInput = Range[16000]; copyAlias = copyInput;
copyMeasure["rewrite-hit-16000", Replace[copyInput, copyX_Integer :> copyX + 1, {1}], Range[2, 16001]];
If[SameQ[copyInput, Range[16000]] && SameQ[copyAlias, copyInput], Null, Exit[2]];
copyMeasure["rewrite-identity-16000", Replace[copyInput, copyX_Integer :> copyX, {1}], Range[16000]];
If[SameQ[copyInput, Range[16000]] && SameQ[copyAlias, copyInput], Null, Exit[2]];
copyMeasure["rewrite-miss-16000", Replace[copyInput, copyMissing -> 0, {1}], Range[16000]];
If[SameQ[copyInput, Range[16000]] && SameQ[copyAlias, copyInput], Null, Exit[2]];
copyCompound = Table[copyF[i, i + 1], {i, 1, 16000}]; copyCompoundAlias = copyCompound;
copyMeasure["rewrite-compound-miss-16000", Replace[copyCompound, copyMissing -> 0, {1}], copyCompound];
If[SameQ[copyCompoundAlias, copyCompound], Null, Exit[2]];
Print["COPY_TIMING_PASS"];
