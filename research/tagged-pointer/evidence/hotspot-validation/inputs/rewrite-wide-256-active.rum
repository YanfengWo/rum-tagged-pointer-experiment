(* Diagnostic input, not an uninstrumented performance benchmark. *)
gHotInput = Range[256]; gHotResult = Null;
RumProfileSnapshot["before"];
RumProfileReset[];
gHotResult = Replace[gHotInput, x_Integer :> x + 1, {1}];
RumProfileSnapshot["after"];
If[SameQ[gHotInput, Range[256]] && SameQ[gHotResult, Range[2, 257]], Null, Exit[2]];
Print["RUM_HOTSPOT_PASS\trewrite-wide\t256\tactive"];
