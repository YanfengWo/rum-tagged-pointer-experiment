(* Deterministic work accounting; no elapsed-time measurements. *)
phaseInput = Range[8];
phaseAlias = phaseInput;
phaseResult = Replace[phaseInput, phaseX_Integer :> phaseX + 1, {1}];
If[SameQ[phaseResult, {2,3,4,5,6,7,8,9}], Null, Print["WORK_LEDGER_FAIL\tincrement\t8\tresult"]; Exit[2]];
If[SameQ[phaseInput, {1,2,3,4,5,6,7,8}], Null, Print["WORK_LEDGER_FAIL\tincrement\t8\tinput"]; Exit[2]];
If[SameQ[phaseAlias, {1,2,3,4,5,6,7,8}], Null, Print["WORK_LEDGER_FAIL\tincrement\t8\talias"]; Exit[2]];
Print["WORK_LEDGER_PASS\tincrement\t8"];
