(* Deterministic work accounting; no elapsed-time measurements. *)
phaseInput = Range[8];
phaseAlias = phaseInput;
phaseResult = Replace[phaseInput, phaseMissing -> 0, {1}];
If[SameQ[phaseResult, {1,2,3,4,5,6,7,8}], Null, Print["WORK_LEDGER_FAIL\tmiss\t8\tresult"]; Exit[2]];
If[SameQ[phaseInput, {1,2,3,4,5,6,7,8}], Null, Print["WORK_LEDGER_FAIL\tmiss\t8\tinput"]; Exit[2]];
If[SameQ[phaseAlias, {1,2,3,4,5,6,7,8}], Null, Print["WORK_LEDGER_FAIL\tmiss\t8\talias"]; Exit[2]];
Print["WORK_LEDGER_PASS\tmiss\t8"];
