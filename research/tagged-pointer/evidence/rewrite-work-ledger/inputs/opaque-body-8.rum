(* Deterministic work accounting; no elapsed-time measurements. *)
phaseInput = Range[8];
phaseAlias = phaseInput;
phaseResult = Replace[phaseInput, phaseX_Integer :> phaseF[phaseX], {1}];
If[SameQ[phaseResult, {phaseF[1],phaseF[2],phaseF[3],phaseF[4],phaseF[5],phaseF[6],phaseF[7],phaseF[8]}], Null, Print["WORK_LEDGER_FAIL\topaque-body\t8\tresult"]; Exit[2]];
If[SameQ[phaseInput, {1,2,3,4,5,6,7,8}], Null, Print["WORK_LEDGER_FAIL\topaque-body\t8\tinput"]; Exit[2]];
If[SameQ[phaseAlias, {1,2,3,4,5,6,7,8}], Null, Print["WORK_LEDGER_FAIL\topaque-body\t8\talias"]; Exit[2]];
Print["WORK_LEDGER_PASS\topaque-body\t8"];
